{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "origami-crm-software",
  "compatibility_date": "2026-05-03",
  "pages_build_output_dir": ".",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "origami-crm-software",
      "database_id": "e8a74eff-2d07-44b4-987f-fbd8572770d6"
    }
  ],
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 100,
    "outboundRequests": 1000,
    "outboundServiceFetches": 100
  }
}
